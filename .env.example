# Leave this unset for local development — the Vite dev server proxies
# /api/* to your local backend (see vite.config.ts), so no URL is needed.
#
# For production (e.g. deploying to Vercel), set this to your deployed
# backend's full URL, no trailing slash:
# VITE_API_URL=https://tailorhub-backend.onrender.com
