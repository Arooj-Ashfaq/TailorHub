# Copy this file to .env and adjust for your machine.

# PostgreSQL 18 connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tailorhub

# Port the backend API server listens on
PORT=4000

# Origin allowed to call the API directly (the frontend's Vite dev proxy
# means this mostly doesn't matter in dev, but it's used as a fallback /
# for calling the API directly with curl, Postman, etc.)
CORS_ORIGIN=http://localhost:8080

NODE_ENV=development
